# Copy to .env (git-ignored, mode 600) and fill in. The launchers ~/.local/bin/taiga-mcp.sh and taiga-mcp-gpt.sh read it. Never put real values here.
# One MCP process = one Taiga login = one actor. The launcher picks the account of the actor (claude or gpt) from the blocks below; the PO/admin
# login is never used as a fallback for an agent, and a missing account stops the launcher.

# Taiga instance base URL, e.g. https://taiga.example.com (the only place the host is configured; nothing is hardcoded in the code).
TAIGA_URL=

# --- PO / admin account (explicit PO path only) ---
# Taiga username that the PO actor must be logged in as (checked by the MCP before every governed write).
TAIGA_MCP_EXPECTED_ACCOUNT_PO=
# Login of the PO/admin account, used only by a runtime that is explicitly the PO, and by scripts/taiga-rest.ts.
TAIGA_USERNAME=
TAIGA_PASSWORD=

# --- Claude Code ---
# Taiga username that the claude actor must be logged in as; a different login fails closed with WORKFLOW_IDENTITY_MISMATCH.
TAIGA_MCP_EXPECTED_ACCOUNT_CLAUDE=
# Login of the dedicated Claude Code account; the launcher maps these to TAIGA_USERNAME/TAIGA_PASSWORD for the claude process.
TAIGA_CLAUDE_USERNAME=
TAIGA_CLAUDE_PASSWORD=

# --- GPT ---
# Taiga username that the gpt actor must be logged in as.
TAIGA_MCP_EXPECTED_ACCOUNT_GPT=
# Login of the dedicated ChatGPT account; the launcher maps these to TAIGA_USERNAME/TAIGA_PASSWORD for the gpt process.
TAIGA_GPT_USERNAME=
TAIGA_GPT_PASSWORD=

# --- Merge authorization signing key (GPT process) ---
# Ed25519 private key (PKCS#8 DER, Base64) that signs the Done / Sprint-close merge authorization. Only the GPT process uses it.
TAIGA_MCP_MERGE_AUTH_PRIVATE_KEY_B64=
