{
  "name": "taiga-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Taiga project management - Full API coverage",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "taiga-mcp": "dist/index.js",
    "taiga-mcp-governance": "dist/governance-cli.js"
  },
  "files": [
    "dist",
    "workflow/templates"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth:keygen": "node scripts/auth-keygen.ts",
    "gitgate": "node ../gitgate/bin/gitgate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=120000 \"test/*.test.ts\"",
    "check:public-surface": "node scripts/public-surface.ts",
    "check:package": "tsc && node scripts/check-package-contents.ts",
    "check:release": "node --test \"test/release/*.test.ts\"",
    "lint": "eslint ."
  },
  "keywords": [
    "mcp",
    "taiga",
    "project-management"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=24"
  }
}
